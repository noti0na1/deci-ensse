import DeciENSSE.Core.Mixed.Leaf

/-! # Leaf Horn presentation and the least extension

Atoms record a variable, a sign, and a path in its leaf cone. Constructor
literals induce push and pop moves, variable inequalities induce copy moves,
and extreme labels supply positive and negative units. Closing the positive
units and the visible seeds under these moves and path extension gives the
least candidate extension. Exclusions detect incompatible opposite leaf atoms.

## Main declarations

- `Move`, `Clause`, `Fact`, `Neg`, `Sol`, `sat_iff_sol`,
  `sol_iff_assignment`, `sol_sInter`, `projected_sInter`, `Hull`,
  `extends_iff_hull`, `least_extension`, `sat_infoInter`.
-/

namespace DeciENSSE.Core.Mixed
open DeciNSSE DeciENSSE.Core.Full

variable {n : ℕ}

/-- A variable, sign, and child word identify a leaf atom. -/
abbrev Config (n : ℕ) (V : Type*) := V × Bool × List (Fin n)

/-- The leaf atoms present in an assignment. -/
def configSet {V : Type*} (c : Fin n → Bool) (ρ : V → Tree n) : Set (Config n V) :=
  {p | p.2.2 ∈ leaf c (ρ p.1) p.2.1}

/-- Literal implications: left push/pop, with the argument variance in the sign. -/
inductive Move {V : Type*} (c : Fin n → Bool) (χ : List (LitT n V)) :
    Config n V → Config n V → Prop
  | copyPlus {u v w} : LitT.le u v ∈ χ → Move c χ (u, false, w) (v, false, w)
  | copyMinus {u v w} : LitT.le u v ∈ χ → Move c χ (v, true, w) (u, true, w)
  | flePush {a u w} (i : Fin n) : LitT.fle a u ∈ χ →
      Move c χ (a i, c i, w) (u, false, i :: w)
  | flePop {a u w} (i : Fin n) : LitT.fle a u ∈ χ →
      Move c χ (u, true, i :: w) (a i, !(c i), w)
  | lefPop {u a w} (i : Fin n) : LitT.lef u a ∈ χ →
      Move c χ (u, false, i :: w) (a i, c i, w)
  | lefPush {u a w} (i : Fin n) : LitT.lef u a ∈ χ →
      Move c χ (a i, !(c i), w) (u, true, i :: w)

/-- Literal implications together with right-extension steps. -/
inductive Clause {V : Type*} (c : Fin n → Bool) (χ : List (LitT n V)) :
    Config n V → Config n V → Prop
  | move {p q} : Move c χ p q → Clause c χ p q
  | extend (v : V) (s : Bool) (w : List (Fin n)) (i : Fin n) :
      Clause c χ (v, s, w) (v, s, w ++ [i])

/-- Positive root units generated by extreme literals. -/
inductive Fact {V : Type*} (χ : List (LitT n V)) : Config n V → Prop
  | bot {v} : LitT.bot v ∈ χ → Fact χ (v, true, [])
  | top {v} : LitT.top v ∈ χ → Fact χ (v, false, [])

/-- Forbidden root units generated by constructor bounds. -/
inductive Neg {V : Type*} (χ : List (LitT n V)) : Config n V → Prop
  | fle {a u} : LitT.fle a u ∈ χ → Neg χ (u, true, [])
  | lef {u a} : LitT.lef u a ∈ χ → Neg χ (u, false, [])

/-- Every variable has this exclusion at every word, independently of χ. -/
inductive Exclusion {V : Type*} : Config n V → Config n V → Prop
  | pair (v : V) (w : List (Fin n)) : Exclusion (v, false, w) (v, true, w)

/-- Every implication preserves membership. -/
def Closed {V : Type*} (c : Fin n → Bool) (χ : List (LitT n V))
    (S : Set (Config n V)) : Prop := ∀ ⦃p q⦄, Clause c χ p q → p ∈ S → q ∈ S

/-- No forbidden root unit belongs to the set. -/
def Avoids {V : Type*} (χ : List (LitT n V)) (S : Set (Config n V)) : Prop :=
  ∀ ⦃p⦄, p ∈ S → ¬ Neg χ p

/-- No pair of opposite leaf atoms belongs to the set. -/
def Consistent {V : Type*} (S : Set (Config n V)) : Prop :=
  ∀ ⦃p q⦄, Exclusion p q → p ∈ S → q ∈ S → False

/-- Closed leaf atoms satisfying all units and exclusions. -/
structure Sol {V : Type*} (c : Fin n → Bool) (χ : List (LitT n V))
    (S : Set (Config n V)) : Prop where
  closed : Closed c χ S
  facts : ∀ ⦃p⦄, Fact χ p → p ∈ S
  avoids : Avoids χ S
  consistent : Consistent S

variable {V : Type*} {c : Fin n → Bool} {χ : List (LitT n V)}

/-- Every tree assignment has disjoint signed leaf cones. -/
theorem configSet_consistent (ρ : V → Tree n) : Consistent (configSet c ρ) := by
  intro p q h hp hq
  cases h with
  | pair v w => exact leaf_disjoint c (ρ v) w hp hq

/-- Exact translation of all five literal types. -/
theorem sat_iff_sol (ρ : V → Tree n) : SatT c ρ χ ↔ Sol c χ (configSet c ρ) := by
  constructor
  · intro h
    refine ⟨?_, ?_, ?_, configSet_consistent ρ⟩
    · intro p q hpq hp
      cases hpq with
      | extend v s w i => exact leaf_extension c (ρ v) s w [i] hp
      | move hm =>
        cases hm with
        | copyPlus hl => exact ((treeLe_iff_leaf _ _ _).mp (h _ hl)).1 hp
        | copyMinus hl => exact ((treeLe_iff_leaf _ _ _).mp (h _ hl)).2 hp
        | flePush i hl =>
          apply ((treeLe_iff_leaf _ _ _).mp (h _ hl)).1
          simpa [configSet] using hp
        | flePop i hl =>
          have hh := ((treeLe_iff_leaf _ _ _).mp (h _ hl)).2 hp
          simpa [configSet] using hh
        | lefPop i hl =>
          have hh := ((treeLe_iff_leaf _ _ _).mp (h _ hl)).1 hp
          simpa [configSet] using hh
        | lefPush i hl =>
          apply ((treeLe_iff_leaf _ _ _).mp (h _ hl)).2
          simpa [configSet] using hp
    · intro p hp
      cases hp with
      | bot hl => exact (leaf_root_minus c _).mpr (h _ hl)
      | top hl => exact (leaf_root_plus c _).mpr (h _ hl)
    · intro p hp hn
      cases hn with
      | fle hl =>
          exact leaf_node_nil c _ true (((treeLe_iff_leaf _ _ _).mp (h _ hl)).2 hp)
      | lef hl =>
          exact leaf_node_nil c _ false (((treeLe_iff_leaf _ _ _).mp (h _ hl)).1 hp)
  · intro h l hl
    cases l with
    | le u v =>
      exact (treeLe_iff_leaf _ _ _).mpr
        ⟨fun _ hw => h.closed (.move (.copyPlus hl)) hw,
         fun _ hw => h.closed (.move (.copyMinus hl)) hw⟩
    | fle a u =>
      apply (treeLe_iff_leaf _ _ _).mpr
      constructor
      · intro w hw
        cases w with
        | nil => exact (leaf_node_nil c _ false hw).elim
        | cons i w =>
          apply h.closed (.move (.flePush i hl))
          simpa [configSet] using hw
      · intro w hw
        cases w with
        | nil => exact (h.avoids hw (.fle hl)).elim
        | cons i w =>
          have hh := h.closed (.move (.flePop i hl)) hw
          simpa [configSet] using hh
    | lef u a =>
      apply (treeLe_iff_leaf _ _ _).mpr
      constructor
      · intro w hw
        cases w with
        | nil => exact (h.avoids hw (.lef hl)).elim
        | cons i w =>
          have hh := h.closed (.move (.lefPop i hl)) hw
          simpa [configSet] using hh
      · intro w hw
        cases w with
        | nil => exact (leaf_node_nil c _ true hw).elim
        | cons i w =>
          apply h.closed (.move (.lefPush i hl))
          simpa [configSet] using hw
    | bot u => exact (leaf_root_minus c _).mp (h.facts (.bot hl))
    | top u => exact (leaf_root_plus c _).mp (h.facts (.top hl))

/-- Clause closure implies arbitrary right-extension closure. -/
theorem Closed.extension {S : Set (Config n V)} (h : Closed c χ S)
    (v : V) (s : Bool) : ExtensionClosed {w | (v, s, w) ∈ S} := by
  intro u w hu
  induction w using List.reverseRecOn with
  | nil => simpa using hu
  | append_singleton w i ih =>
    simpa [List.append_assoc] using h (.extend v s (u ++ w) i) ih

/-- Decode a closed, consistent set into an assignment. -/
noncomputable def assignmentOf (S : Set (Config n V)) (hc : Closed c χ S)
    (hd : Consistent S) : V → Tree n := fun v =>
  decode c ⟨fun s => {w | (v, s, w) ∈ S}, hc.extension v,
    fun w hp hm => hd (.pair v w) hp hm⟩

/-- Decoding recovers precisely the given atoms. -/
@[simp] theorem configSet_assignmentOf (S : Set (Config n V))
    (hc : Closed c χ S) (hd : Consistent S) :
    configSet c (assignmentOf S hc hd) = S := by
  ext ⟨v, s, w⟩
  exact Set.ext_iff.mp (leaf_decode c _ s) w

/-- Leaf atoms determine the entire assignment. -/
theorem configSet_injective : Function.Injective (configSet (V := V) c) := by
  intro ρ τ he
  funext v
  apply leaf_injective c
  intro s
  ext w
  exact Set.ext_iff.mp he (v, s, w)

/-- Horn solutions are exactly atom sets of satisfying assignments. -/
theorem sol_iff_assignment {S : Set (Config n V)} :
    Sol c χ S ↔ ∃ ρ, SatT c ρ χ ∧ configSet c ρ = S := by
  constructor
  · intro h
    refine ⟨assignmentOf S h.closed h.consistent, ?_, configSet_assignmentOf ..⟩
    apply (sat_iff_sol _).mpr
    simpa using h
  · rintro ⟨ρ, h, rfl⟩; exact (sat_iff_sol ρ).mp h

/-- Nonempty intersections preserve all clauses, including exclusions. -/
theorem sol_sInter {F : Set (Set (Config n V))} (hne : F.Nonempty)
    (hF : ∀ S ∈ F, Sol c χ S) : Sol c χ (⋂₀ F) := by
  refine ⟨?_, ?_, ?_, ?_⟩
  · intro p q hpq hp S hs
    exact (hF S hs).closed hpq (hp S hs)
  · intro p hp S hs; exact (hF S hs).facts hp
  · intro p hp hn
    obtain ⟨S, hs⟩ := hne
    exact (hF S hs).avoids (hp S hs) hn
  · intro p q hpq hp hq
    obtain ⟨S, hs⟩ := hne
    exact (hF S hs).consistent hpq (hp S hs) (hq S hs)

/-- The intersection of two Horn solutions is a solution. -/
theorem sol_inter {S T : Set (Config n V)} (hs : Sol c χ S) (ht : Sol c χ T) :
    Sol c χ (S ∩ T) := by
  refine ⟨?_, ?_, ?_, ?_⟩
  · intro p q h hp; exact ⟨hs.closed h hp.1, ht.closed h hp.2⟩
  · intro p hp; exact ⟨hs.facts hp, ht.facts hp⟩
  · intro p hp; exact hs.avoids hp.1
  · intro p q h hp hq; exact hs.consistent h hp.1 hq.1

/-- Pointwise information intersection intersects assignment atoms. -/
@[simp] theorem configSet_infoInter (ρ τ : V → Tree n) :
    configSet c (fun v => infoInter c (ρ v) (τ v)) = configSet c ρ ∩ configSet c τ := by
  ext ⟨v, s, w⟩; exact Set.ext_iff.mp (leaf_infoInter c (ρ v) (τ v) s) w

/-- Information intersection preserves satisfaction. -/
theorem sat_infoInter {ρ τ : V → Tree n} (hρ : SatT c ρ χ) (hτ : SatT c τ χ) :
    SatT c (fun v => infoInter c (ρ v) (τ v)) χ := by
  apply (sat_iff_sol _).mpr
  rw [configSet_infoInter]
  exact sol_inter ((sat_iff_sol _).mp hρ) ((sat_iff_sol _).mp hτ)

/-- Finite derivations; extension edges are genuine steps in this relation. -/
inductive Reach (c : Fin n → Bool) (χ : List (LitT n V)) (a : Config n V) : Config n V → Prop
  | refl : Reach c χ a a
  | step {b d} : Reach c χ a b → Clause c χ b d → Reach c χ a d

/-- The positive closure generated by units and seed atoms. -/
def Hull (c : Fin n → Bool) (χ : List (LitT n V)) (A : Set (Config n V)) : Set (Config n V) :=
  {b | ∃ a, (Fact χ a ∨ a ∈ A) ∧ Reach c χ a b}

/-- Reachability preserves membership in a closed set. -/
theorem Reach.mem_of_closed {a b : Config n V} {S : Set (Config n V)}
    (h : Reach c χ a b) (hc : Closed c χ S) (ha : a ∈ S) : b ∈ S := by
  induction h with
  | refl => exact ha
  | step _ hs ih => exact hc hs ih

/-- The generated hull is closed under all clauses. -/
theorem hull_closed (A : Set (Config n V)) : Closed c χ (Hull c χ A) := by
  rintro a b h ⟨s, hs, hr⟩
  exact ⟨s, hs, .step hr h⟩

/-- The generated hull contains all positive units. -/
theorem hull_facts (A : Set (Config n V)) {p : Config n V} (hp : Fact χ p) :
    p ∈ Hull c χ A := ⟨p, Or.inl hp, .refl⟩

/-- Every seed belongs to its hull. -/
theorem subset_hull (A : Set (Config n V)) : A ⊆ Hull c χ A :=
  fun p hp => ⟨p, Or.inr hp, .refl⟩

/-- The hull is contained in every closed set containing its generators. -/
theorem hull_least {A S : Set (Config n V)} (hc : Closed c χ S)
    (hf : ∀ ⦃p⦄, Fact χ p → p ∈ S) (ha : A ⊆ S) : Hull c χ A ⊆ S := by
  rintro b ⟨a, hf' | ha', hr⟩
  · exact hr.mem_of_closed hc (hf hf')
  · exact hr.mem_of_closed hc (ha ha')

variable {X Z : Type*}

/-- Embed a visible atom into the combined variable space. -/
def visible (a : Config n X) : Config n (X ⊕ Z) := (.inl a.1, a.2)

/-- Restrict a combined atom set to visible variables. -/
def restrict (S : Set (Config n (X ⊕ Z))) : Set (Config n X) := {a | visible a ∈ S}

/-- Visible atom sets that admit a Horn solution extension. -/
def Projected (c : Fin n → Bool) (ψ : List (LitT n (X ⊕ Z))) : Set (Set (Config n X)) :=
  {S | ∃ T, Sol c ψ T ∧ restrict T = S}

/-- Projection corresponds to a satisfying hidden assignment. -/
theorem projected_configSet (ρ : X → Tree n) (ψ : List (LitT n (X ⊕ Z))) :
    configSet c ρ ∈ Projected c ψ ↔ ∃ σ, SatT c (Sum.elim ρ σ) ψ := by
  constructor
  · rintro ⟨T, ht, he⟩
    obtain ⟨τ, hτ, rfl⟩ := sol_iff_assignment.mp ht
    have hv : (fun x => τ (.inl x)) = ρ := configSet_injective he
    refine ⟨fun z => τ (.inr z), ?_⟩
    have he' : Sum.elim ρ (fun z => τ (.inr z)) = τ := by
      funext v
      cases v with
      | inl x => exact (congrFun hv x).symm
      | inr z => rfl
    rw [he']; exact hτ
  · rintro ⟨σ, hσ⟩
    exact ⟨configSet c (Sum.elim ρ σ), (sat_iff_sol _).mp hσ, rfl⟩

/-- Entailment is inclusion in the existentially projected leaf solution family. -/
theorem existsEntails_iff_sol_subset (φ : List (LitT n X)) (ψ : List (LitT n (X ⊕ Z))) :
    ExistsEntailsT c φ ψ ↔ ∀ S, Sol c φ S → S ∈ Projected c ψ := by
  constructor
  · intro h S hs
    obtain ⟨ρ, hρ, rfl⟩ := sol_iff_assignment.mp hs
    obtain ⟨σ, _, hσ⟩ := h ρ (fun _ => trivial) hρ
    exact (projected_configSet ρ ψ).mpr ⟨σ, hσ⟩
  · intro h ρ _ hρ
    obtain ⟨σ, hσ⟩ := (projected_configSet ρ ψ).mp (h _ ((sat_iff_sol _).mp hρ))
    exact ⟨σ, fun _ => trivial, hσ⟩

/-- Intersect whole witnesses before restricting to visible variables. -/
theorem projected_sInter (ψ : List (LitT n (X ⊕ Z)))
    {F : Set (Set (Config n X))} (hne : F.Nonempty) (hF : F ⊆ Projected c ψ) :
    ⋂₀ F ∈ Projected c ψ := by
  let G : Set (Set (Config n (X ⊕ Z))) := {T | Sol c ψ T ∧ restrict T ∈ F}
  have hG : G.Nonempty := by
    obtain ⟨S, hs⟩ := hne
    obtain ⟨T, ht, rfl⟩ := hF hs
    exact ⟨T, ht, hs⟩
  refine ⟨⋂₀ G, sol_sInter hG (fun _ h => h.1), ?_⟩
  apply Set.Subset.antisymm
  · intro a ha S hs
    obtain ⟨T, ht, rfl⟩ := hF hs
    exact ha T ⟨ht, hs⟩
  · intro a ha T ht; exact ha (restrict T) ht.2

/-- The seed set contains exactly the true visible atoms; units are added by Hull. -/
def visibleSeeds (c : Fin n → Bool) (ρ : X → Tree n) : Set (Config n (X ⊕ Z)) :=
  visible '' configSet c ρ

/-- Extension is equivalent to consistency, avoidance of negative units,
and no new visible atoms. -/
theorem extends_iff_hull (ρ : X → Tree n) (ψ : List (LitT n (X ⊕ Z))) :
    (∃ σ, SatT c (Sum.elim ρ σ) ψ) ↔
      Avoids ψ (Hull c ψ (visibleSeeds c ρ)) ∧
      Consistent (Hull c ψ (visibleSeeds c ρ)) ∧
      restrict (Hull c ψ (visibleSeeds c ρ)) ⊆ configSet c ρ := by
  rw [← projected_configSet]
  constructor
  · rintro ⟨T, ht, he⟩
    have ha : visibleSeeds c ρ ⊆ T := by
      rintro _ ⟨a, ha, rfl⟩
      change a ∈ restrict T
      rwa [he]
    have hh := hull_least ht.closed ht.facts ha
    refine ⟨fun {_} hp => ht.avoids (hh hp),
      fun {_ _} h hp hq => ht.consistent h (hh hp) (hh hq), ?_⟩
    intro a ha
    rw [← he]
    exact hh ha
  · rintro ⟨hn, hd, hv⟩
    refine ⟨Hull c ψ (visibleSeeds c ρ),
      ⟨hull_closed _, (fun {_} => hull_facts _), hn, hd⟩, Set.Subset.antisymm hv ?_⟩
    intro a ha
    exact subset_hull _ ⟨a, ha, rfl⟩

/-- When the checks pass, the closure itself is the least full extension. -/
theorem least_extension (ρ : X → Tree n) (ψ : List (LitT n (X ⊕ Z)))
    (he : ∃ σ, SatT c (Sum.elim ρ σ) ψ) :
    ∃ σ, SatT c (Sum.elim ρ σ) ψ ∧
      configSet c (Sum.elim ρ σ) = Hull c ψ (visibleSeeds c ρ) ∧
      ∀ τ, SatT c (Sum.elim ρ τ) ψ →
        configSet c (Sum.elim ρ σ) ⊆ configSet c (Sum.elim ρ τ) := by
  obtain ⟨hn, hd, hv⟩ := (extends_iff_hull ρ ψ).mp he
  have hs : Sol c ψ (Hull c ψ (visibleSeeds c ρ)) :=
    ⟨hull_closed _, (fun {_} => hull_facts _), hn, hd⟩
  obtain ⟨θ, hθ, hEq⟩ := sol_iff_assignment.mp hs
  have hr : restrict (Hull c ψ (visibleSeeds c ρ)) = configSet c ρ :=
    Set.Subset.antisymm hv (fun a ha => subset_hull _ ⟨a, ha, rfl⟩)
  have hx : (fun x => θ (.inl x)) = ρ :=
    configSet_injective ((congrArg restrict hEq).trans hr)
  have ht : Sum.elim ρ (fun z => θ (.inr z)) = θ := by
    funext v
    cases v with
    | inl x => exact (congrFun hx x).symm
    | inr z => rfl
  refine ⟨fun z => θ (.inr z), ht ▸ hθ, ht ▸ hEq, ?_⟩
  intro τ hτ
  rw [ht, hEq]
  have hsol := (sat_iff_sol _).mp hτ
  apply hull_least hsol.closed hsol.facts
  rintro _ ⟨a, ha, rfl⟩
  exact ha

end DeciENSSE.Core.Mixed
